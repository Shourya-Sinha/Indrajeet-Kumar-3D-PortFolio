# Database Configuration
# Set MONGODB_URI for MongoDB / MongoDB Atlas in production.
# When omitted, the application runs with a schema-validated local persistence store under ./storage/db.
MONGODB_URI=
DB_MODE=auto

# Site & Public URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Administrator Authentication & Initial Seed
AUTH_SECRET=change-this-to-a-long-random-hex-secret-in-production
ADMIN_EMAIL=Krindrajeet.c@gmail.com
ADMIN_PASSWORD=ChangeMeStrongPassword!2026
ADMIN_NAME=Shourya Sinha

# Cloudinary Media & Document Storage (optional for local preview; required for cloud media CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Inquiry Notifications (Resend or SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=portfolio@shouryasinha.dev
ADMIN_NOTIFICATION_EMAIL=Krindrajeet.c@gmail.com

# GitHub Integration (optional token raises API rate limits from 60/hr to 5000/hr)
GITHUB_USERNAME=Shourya-Sinha
GITHUB_TOKEN=
